# Brushy Bear CRM — environment variables
# Copy to .env.local and fill in what you need. NEVER commit real values.
# Every key is commented out: the app builds and runs the shell with none set.

# ── App ─────────────────────────────────────────────────────────────────────
# APP_URL=http://localhost:3000

# ── Supabase (values printed by `pnpm supabase start`) ──────────────────────
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Background worker (Vercel Cron → /api/cron/worker), min 16 chars ────────
# CRON_SECRET=

# ── Website lead intake (HMAC shared with the website repo), min 32 chars ───
# LEAD_INTAKE_HMAC_SECRET=

# ── Seeding ─────────────────────────────────────────────────────────────────
# Comma-separated owner emails (Hunter Lee, Erik). Kept out of code on purpose.
# SEED_OWNER_EMAILS=
# Demo data for dev/preview only. Never true in production.
# DEMO_DATA=false

# ── Integrations (SPEC §2.1) — everything ships disconnected ────────────────
# Each flag defaults to its disconnected provider. Switching to a real provider
# ALSO requires a `connected` row in integration_connections (Phase 1) and the
# provider's credentials below. See docs/INTEGRATIONS.md.
# INTEGRATION_SMS_PROVIDER=outbox          # outbox | twilio
# INTEGRATION_VOICE_PROVIDER=outbox        # outbox | twilio
# INTEGRATION_EMAIL_PROVIDER=outbox        # outbox | resend | sendgrid
# INTEGRATION_CALENDAR_PROVIDER=outbox     # outbox | google_calendar
# INTEGRATION_ACCOUNTING_PROVIDER=outbox   # outbox | quickbooks_online
# INTEGRATION_PAYMENTS_PROVIDER=outbox     # outbox | stripe
# INTEGRATION_ESIGN_PROVIDER=builtin       # builtin | docusign | dropbox_sign
# INTEGRATION_GEO_PROVIDER=outbox          # outbox | google_places | mapbox
# INTEGRATION_WEATHER_PROVIDER=outbox      # outbox | nws | openweather
# INTEGRATION_PHOTOS_PROVIDER=outbox       # outbox | companycam
# INTEGRATION_REVIEWS_PROVIDER=outbox      # outbox | google_business_profile
# INTEGRATION_AI_PROVIDER=disabled         # disabled | anthropic

# Provider credentials (only when a provider is connected later):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DOCUSIGN_INTEGRATION_KEY=
# DROPBOX_SIGN_API_KEY=
# GOOGLE_MAPS_API_KEY=
# MAPBOX_ACCESS_TOKEN=
# NWS_USER_AGENT=
# OPENWEATHER_API_KEY=
# COMPANYCAM_API_TOKEN=
# GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=
# ANTHROPIC_API_KEY=
